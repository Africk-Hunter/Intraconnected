# Copy to keystore.properties (gitignored) and fill in. Never commit the real file.
# Create the upload keystore once, keep it and its passwords in a password manager:
#   keytool -genkeypair -v -keystore intraconnected-upload.jks -alias upload #     -keyalg RSA -keysize 2048 -validity 10000
# storeFile is relative to the android/ folder.
storeFile=intraconnected-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
